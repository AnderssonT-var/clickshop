Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Clean addresses: old links to /tienda.php, /seguimiento.php, /admin.php and
  # /index.php are sent (301) to /tienda, /seguimiento, /admin and /.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+(tienda|seguimiento|admin)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
  RewriteRule ^ / [R=301,L,NE]
  RewriteRule ^(tienda|seguimiento|admin)/$ /$1 [R=301,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^admin$ admin.php [L,QSA]
  RewriteRule ^tienda$ tienda.php [L,QSA]
  RewriteRule ^seguimiento$ seguimiento.php [L,QSA]
  RewriteRule ^api/?$ api.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>
